# ==============================================================================
# .gitignore - Next.js (React) Full Stack + Supabase
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SEGURIDAD & VARIABLES DE ENTORNO (CRÍTICO)
# ------------------------------------------------------------------------------
# NUNCA versionar claves API de Supabase, cadenas de conexión Postgres ni secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos de credenciales o certificados
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# 2. DEPENDENCIAS & GESTORES DE PAQUETES
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# Registros y logs de depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Caché de gestores de paquetes
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.pnpm-store/

# ------------------------------------------------------------------------------
# 3. BUILD, COMPILACIÓN & PRODUCCIÓN (NEXT.JS)
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/

# Caché de compilador y Next.js telemetry
.next/cache/
next-env.d.ts.bak

# Archivos de análisis de bundle (Next.js Bundle Analyzer)
report.html
.webpack/

# ------------------------------------------------------------------------------
# 4. SUPABASE (BaaS & DESARROLLO LOCAL)
# ------------------------------------------------------------------------------
# Directorios temporales e internos generados por Supabase CLI / Docker
.temp/
supabase/.temp/
supabase/.branches/

# Bases de datos SQLite locales o dumps accidentales de migración
*.sqlite
*.sqlite-journal
*.dump
*.sql.bak

# ------------------------------------------------------------------------------
# 5. TESTING, COBERTURA & REPORTES
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
cypress/videos/
cypress/screenshots/

# ------------------------------------------------------------------------------
# 6. ARCHIVOS DEL SISTEMA OPERATIVO
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 7. EDITORES & ENTORNOS DE DESARROLLO (IDEs)
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ IDEA, etc.)
.idea/
*.iws
*.iml
*.ipr

# VIM & Sublime Text
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 8. TYPESCRIPT & MISCELÁNEO
# ------------------------------------------------------------------------------
*.tsbuildinfo
.turbo/
.vercel/
